{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  // The serverless functions and the one module they share with the app. No
  // DOM lib on purpose: it's what stops a browser-only API drifting into code
  // that runs in Node.
  "include": ["api", "src/lib/ledger-types.ts", "src/lib/tokens.ts"]
}
